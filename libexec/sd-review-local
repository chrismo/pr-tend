#!/usr/bin/env bash5
#
# sd review-local - the default local reviewer (A8): one fresh, read-only
# model session over a branch's change; findings as JSON on stdout.
#
# Usage: SHEEPDOG_BASE=<sha> SHEEPDOG_HEAD=<sha> [SHEEPDOG_TASK=<text>] sd review-local
#
# The contract, which any script named by settings.localReview must keep:
#   input   env SHEEPDOG_BASE, SHEEPDOG_HEAD (SHAs); SHEEPDOG_TASK (the task, so
#           out-of-scope changes can be flagged); cwd = the worktree
#   output  a JSON list [{file, line, severity, body}] on stdout
#   exit    0: the review completed (the list may be empty); non-zero: the
#           reviewer failed, which sd act review never treats as clean
#
# Harness, model and effort come from `sd config step review`. Every run is a
# new session (fresh context, never the authoring conversation) with read-only
# tools: no edits, no gh. The prompt is the guidance (settings.reviewPrompt: a
# path, relative ones read from SHEEPDOG_BASE so the branch can't rewrite its
# own review; empty means .sheepdog/review.md in the base commit, else
# lib/prompts/review.md), then the fixed reporting rules (lib/review-rules.md),
# the task, the commits and the diff. Why a local review before the bot: #79
# (Design record).

set -euo pipefail

LIB="$(dirname "$(realpath "$0")")/../lib"
source "$LIB/sheepdog.sh"
source "$LIB/config.sh"

die() { echo "sd review-local: $*" >&2; exit 1; }

[[ -n ${SHEEPDOG_BASE:-} ]] || die "SHEEPDOG_BASE is not set (the base SHA)"
[[ -n ${SHEEPDOG_HEAD:-} ]] || die "SHEEPDOG_HEAD is not set (the head SHA)"
prc_super_init || exit 1
git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
branch=$(git branch --show-current 2>/dev/null || true)

cfg=$(prc_step review "$branch" "") || die "sd config failed"
h=$(prc_val "$cfg" harness) || die "sd config failed"
timeout=$(prc_get settings.stepTimeout "$branch" false) || die "sd config failed"
[[ $timeout =~ ^[1-9][0-9]*$ ]] || die "settings.stepTimeout must be whole seconds: $timeout"

diff=$(git diff "$SHEEPDOG_BASE" "$SHEEPDOG_HEAD") || die "git diff $SHEEPDOG_BASE $SHEEPDOG_HEAD failed"
commits=$(git log --format='- %s' "$SHEEPDOG_BASE..$SHEEPDOG_HEAD")
range="${SHEEPDOG_BASE:0:7}..${SHEEPDOG_HEAD:0:7}"
prompt=$(step_guidance reviewPrompt "$branch" "$SHEEPDOG_BASE" "$LIB/prompts/review.md") \
  || die "can't read the review guidance"
rules=$(cat "$LIB/review-rules.md") || die "can't read $LIB/review-rules.md"
prompt+=$'\n\n'"$rules"
prompt+=$'\n\nTask: '"${SHEEPDOG_TASK:-(none recorded)}"
prompt+=$'\n\nCommits ('"$range"$'):\n'"$commits"
prompt+=$'\n\nDiff:\n'"$diff"

read -r -d '' SCHEMA <<'EOF' || true
{"type": "object", "required": ["findings"],
 "properties": {"findings": {"type": "array", "items": {
   "type": "object", "required": ["file", "line", "severity", "body"],
   "properties": {"file": {"type": "string"}, "line": {"type": "integer"},
                  "severity": {"type": "string", "enum": ["error", "warning", "nit"]},
                  "body": {"type": "string"}}}}}}
EOF

# Read-only: harness_run takes its tool lists from these.
HARNESS_CLAUDE_ALLOW=$HARNESS_READONLY_ALLOW
HARNESS_PI_TOOLS="read"
export HARNESS_STEP=review HARNESS_BRANCH=$branch
sid=$(uuidgen | tr 'A-F' 'a-f')
echo "sd review-local: $h (new session $sid) is reviewing ${branch:+$branch (}$range${branch:+)}…" >&2
result=$(harness_run "$h" "$sid" new "$timeout" "$prompt" "$SCHEMA" "$cfg") \
  || die "the $h review failed or returned no usable result"
findings=$(prc_json 'values findings | where kind(this) == "array"' "$result" 2>/dev/null) \
  && [[ -n $findings ]] || die "the $h review returned no findings list"
printf '%s\n' "$findings"

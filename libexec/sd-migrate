#!/usr/bin/env bash5
#
# sd-migrate - move pr-tend's state to sheepdog's names. One-time, for a
# machine that ran pr-tend; safe to re-run.
#
# Usage: sd migrate [--dry-run]
#
# Moves, in every repo registered under either name and the current one:
#   git config  pr-tend.* (global and per repo) -> sheepdog.*
#               branch.<b>.pr-tend -> .sheepdog, branch.<b>.pr-<key> -> .sd-<key>
#   refs        refs/pr-tend/* -> refs/sheepdog/*
#   files       <git dir>/pr-tend/, ~/.config/pr-tend/, ~/.local/state/pr-tend/
#
# Something already under a new name with a different value is a conflict:
# both are kept and reported, and the exit status is 1. The repo list and
# handled ids merge instead.
#
# Warns about, but doesn't change: PR_TEND_* and PR_WATCH_* in the environment
# or shell startup files, the old launchd job, a configured local reviewer.

set -euo pipefail

dry=false
case ${1:-} in
  "") ;;
  --dry-run) dry=true ;;
  -h|--help) sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
  *) echo "sd migrate: unknown option: $1" >&2; exit 1 ;;
esac

moved=0 conflicts=0
warn() { echo "warning: $*" >&2; }
conflict() { echo "conflict: $*" >&2; conflicts=$((conflicts + 1)); }

# act <what> <cmd...>: run cmd, or only say so under --dry-run.
act() {
  local what=$1; shift
  moved=$((moved + 1))
  if $dry; then echo "would move $what"; else "$@"; echo "moved $what"; fi
}

BRANCH_KEYS='task|parent|session|harness|handled|lock|scope'

# new_key <key>: the sheepdog name for a pr-tend git config key; empty if not one.
new_key() {
  local k=$1
  if [[ $k == pr-tend.* ]]; then echo "sheepdog.${k#pr-tend.}"
  elif [[ $k == branch.*.pr-tend ]]; then echo "${k%.pr-tend}.sheepdog"
  elif [[ $k =~ ^(branch\..+)\.pr-($BRANCH_KEYS)$ ]]; then echo "${BASH_REMATCH[1]}.sd-${BASH_REMATCH[2]}"
  fi
}

# Keys that hold a list; any other key holds one value.
MULTI='^(sheepdog\.repo|branch\..+\.sd-handled)$'

# move_key <git config args...> -- <old> <new>: add the OLDS missing from NEWS
# to new, then drop old.
move_key() {
  local -a cfg=()
  while [[ $1 != -- ]]; do cfg+=("$1"); shift; done
  local old=$2 new=$3 v
  for v in "${OLDS[@]}"; do
    [[ " ${NEWS[*]@Q} " == *" ${v@Q} "* ]] || git "${cfg[@]}" --add "$new" "$v"
  done
  git "${cfg[@]}" --unset-all "$old"
}

# migrate_config <label> <git config args...>
migrate_config() {
  local label=$1; shift
  local entry k nk i rc=0
  local -a ks=() vs=() order=()
  local -A seen=()
  while IFS= read -r -d '' entry; do
    k=${entry%%$'\n'*}
    ks+=("$k")
    # No newline: a key set with no value, which git reads as true.
    if [[ $entry == *$'\n'* ]]; then vs+=("${entry#*$'\n'}"); else vs+=(true); fi
    if [[ -z ${seen[$k]:-} ]]; then seen[$k]=1; order+=("$k"); fi
  done < <(git "$@" --get-regexp -z '^(pr-tend\.|branch\..*\.pr-)')
  wait $! || rc=$?
  (( rc <= 1 )) || { conflict "${label}couldn't read git config (exit $rc)"; return; }
  for k in "${order[@]}"; do
    nk=$(new_key "$k")
    [[ -n $nk ]] || continue
    OLDS=()
    for i in "${!ks[@]}"; do
      if [[ ${ks[i]} == "$k" ]]; then OLDS+=("${vs[i]}"); fi
    done
    mapfile -d '' -t NEWS < <(git "$@" --get-all -z "$nk")
    if [[ ! $nk =~ $MULTI ]] && (( ${#NEWS[@]} )) && [[ ${NEWS[*]@Q} != "${OLDS[*]@Q}" ]]; then
      conflict "$label$nk is ${NEWS[*]@Q} but $k is ${OLDS[*]@Q}; kept both"
    else
      act "$label$k -> $nk" move_key "$@" -- "$k" "$nk"
    fi
  done
}

move_ref() { printf 'create %s %s\ndelete %s %s\n' "$3" "$2" "$1" "$2" | git -C "$4" update-ref --stdin; }

# migrate_refs <repo>
migrate_refs() {
  local repo=$1 ref sha new cur
  while read -r ref sha; do
    new=refs/sheepdog/${ref#refs/pr-tend/}
    cur=$(git -C "$repo" rev-parse -q --verify "$new" || true)
    if [[ -z $cur ]]; then
      act "$repo: $ref -> $new" move_ref "$ref" "$sha" "$new" "$repo"
    elif [[ $cur == "$sha" ]]; then
      act "$repo: $ref -> $new (already there)" git -C "$repo" update-ref -d "$ref" "$sha"
    else
      conflict "$repo: $new is ${cur:0:7} but $ref is ${sha:0:7}; kept both"
    fi
  done < <(git -C "$repo" for-each-ref --format='%(refname) %(objectname)' refs/pr-tend/)
}

move_into() { mkdir -p "$2" && mv "$1" "$2/"; }

# migrate_dir <old> <new>: old's entries into new, then old if empty. A linked old
# moves as the link, leaving its target alone.
migrate_dir() {
  local old=$1 new=$2 f
  if [[ -L $old ]]; then
    if [[ -e $new || -L $new ]]; then
      conflict "$old is a link and $new already exists; kept both"
    else
      act "$old -> $new" mv "$old" "$new"
    fi
    return 0
  fi
  [[ -d $old ]] || return 0
  while IFS= read -r -d '' f; do
    if [[ -e $new/${f##*/} ]]; then
      conflict "$new/${f##*/} already exists; kept $f"
    else
      act "$f -> $new/" move_into "$f" "$new"
    fi
  done < <(find "$old" -mindepth 1 -maxdepth 1 -print0)
  $dry || rmdir "$old" 2>/dev/null || true
}

config_files=()

# ── global ───────────────────────────────────────────────────────────────────

mapfile -t repos < <(git config --global --get-all pr-tend.repo || true; git config --global --get-all sheepdog.repo || true)
here=$(git rev-parse --show-toplevel 2>/dev/null) && repos+=("$here")

migrate_config "global: " config --global

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
migrate_dir "$config_home/pr-tend" "$config_home/sheepdog"
config_files+=("$config_home"/{pr-tend,sheepdog}/config.json)
migrate_dir "$HOME/.local/state/pr-tend" "$HOME/.local/state/sheepdog"

# ── per repo ─────────────────────────────────────────────────────────────────

declare -A done_dirs=()
for repo in "${repos[@]}"; do
  if [[ ! -d $repo ]]; then
    warn "registered repo $repo doesn't exist; if it moved, run sd act enroll from its new path"
    continue
  fi
  common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || { warn "registered repo $repo isn't a git repository"; continue; }
  [[ -z ${done_dirs[$common]:-} ]] || continue
  done_dirs[$common]=1
  migrate_config "$repo: " -C "$repo" config --local
  migrate_refs "$repo"
  migrate_dir "$common/pr-tend" "$common/sheepdog"
  config_files+=("$common"/{pr-tend,sheepdog}/*.json)
done

# ── warnings ─────────────────────────────────────────────────────────────────

new_env() { if [[ $1 == PR_TEND_* ]]; then echo "SHEEPDOG_${1#PR_TEND_}"; else echo "SHEEPDOG_${1#PR_}"; fi; }

while read -r v; do
  warn "$v is set; sheepdog reads $(new_env "$v")"
done < <(compgen -e | grep -E '^PR_(TEND|WATCH)_' || true)

for rc in "$HOME"/{.zshrc,.zshenv,.zprofile,.bashrc,.bash_profile,.profile}; do
  [[ -f $rc ]] || continue
  while IFS=: read -r line v; do
    warn "$rc:$line uses $v; sheepdog reads $(new_env "$v")"
  done < <(grep -noE '\bPR_(TEND|WATCH)_[A-Z_]+' "$rc" || true)
done

old_plist=${SHEEPDOG_WATCH_LAUNCH_AGENTS:-$HOME/Library/LaunchAgents}/com.pr-tend.pr-watch.plist
[[ -e $old_plist ]] && warn "the old watcher job com.pr-tend.pr-watch is installed; ./install.sh (or sd watch install) replaces it"

for f in "${config_files[@]}"; do
  [[ -f $f ]] && grep -q localReview "$f" \
    && warn "$f sets settings.localReview: the reviewer now gets SHEEPDOG_BASE, SHEEPDOG_HEAD and SHEEPDOG_TASK (were PR_TEND_*)"
done

(( moved || conflicts )) || echo "nothing to migrate"
(( conflicts == 0 ))

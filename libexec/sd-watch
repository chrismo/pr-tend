#!/usr/bin/env bash5
#
# sd watch - observe-only pass over every enrolled branch.
#
# Usage: sd watch [status | install | uninstall]
#
#   (none)     for each repo in global git config sheepdog.repo: fetch, then
#              sd state every branch with branch.<name>.sheepdog=true. Writes a
#              glyph for the branch's worktree (shown by tab-status), notifies
#              on reasons chrismo is needed that are new since the last pass,
#              and records the pass. Also deletes refs/sheepdog/<b>/* whose
#              branch no longer exists (pins outlive a branch -D).
#   status     print the last pass
#   install    launchd job: a pass every settings.interval seconds (default 300)
#   uninstall  remove the job
#
# Glyphs: ❌ needs chrismo   ⚠️ state unknown   🔧 work for later   ⏳ waiting (CI, review)
#         ✅ ready to merge  🏁 merged          🚫 closed
# Notified: CI red, restack conflict, human items, foreign push, merged,
# ready to merge.
#
# Env:    SHEEPDOG_STATE_DIR (~/.local/state/sheepdog), STATUS_DIR (~/.claude/tab-status)
#         SHEEPDOG_WATCH_TIMEOUT (120): seconds a fetch or sd state may take
# Config: read with lib/config.sh, no branch file (global file over
#         built-in defaults): settings.notify, .interval, .remote.
#         notify — shell command, run with <title> <message> appended
#         (default: a macOS notification)

set -euo pipefail

source "$(dirname "$(realpath "$0")")/../lib/sheepdog.sh"
source "$(dirname "$(realpath "$0")")/../lib/config.sh"

STATE_DIR=${SHEEPDOG_STATE_DIR:-$HOME/.local/state/sheepdog}
STATUS_DIR=${STATUS_DIR:-$HOME/.claude/tab-status}
LABEL=com.sheepdog.watch
# Earlier labels: a machine still running one would run two watchers.
OLD_LABELS=(com.agent-rig.pr-watch com.pr-tend.pr-watch)
LAUNCH_AGENTS=${SHEEPDOG_WATCH_LAUNCH_AGENTS:-$HOME/Library/LaunchAgents}
TIMEOUT=${SHEEPDOG_WATCH_TIMEOUT:-120}

read -r -d '' CLASSIFY <<'EOF' || true
values {next: kind(next) == "array" ? next : []}
| values {next, k: coalesce([unnest next | values key], []),
          red: coalesce([unnest next | where key in ["ci-red", "conflict", "human", "foreign"] | values {key, msg: say}], []),
          waiting: len(coalesce([unnest next | where who != "wait"], [])) == 0}
| values case
    when len(next) == 0 then {glyph: "⚠️", reasons: [], note: "sd state gave no next steps"}
    when k == ["merged"] then {glyph: "🏁", reasons: [{key: "merged", msg: next[0].say}]}
    when k == ["closed"] then {glyph: "🚫", reasons: []}
    when len(red) > 0 then {glyph: "❌", reasons: red}
    when "errors" in k or "stale" in k then {glyph: "⚠️", reasons: []}
    when k == ["ready"] then {glyph: "✅", reasons: [{key: "ready", msg: next[0].say}]}
    when waiting then {glyph: "⏳", reasons: []}
    else {glyph: "🔧", reasons: []} end
EOF

# Notifier stdout would land in the pass record (check runs inside $(...)).
notify() {
  local cmd
  cmd=$(prc_get settings.notify "" true) || echo "sd watch: sd config failed; using the default notifier" >&2
  if [[ -n $cmd ]]; then
    sh -c "$cmd"' "$@"' _ "$1" "$2" </dev/null >&2 || echo "sd watch: notify failed: $cmd" >&2
  else
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
      -e 'end run' "$1" "$2" </dev/null >/dev/null || echo "sd watch: notify failed: osascript" >&2
  fi
}

write_glyph() { # write_glyph <worktree-or-empty> <branch> <glyph>
  [[ -n $1 ]] || return 0
  local f; f="$STATUS_DIR/$(basename "$1").pr"
  printf '%s\t%s\n' "$2" "$3" > "$f"
  echo "$f" >> "$WRITTEN"
}

# check <repo> <name> <branch> <worktree-or-empty>. Runs inside $(...), where -e
# is off: every failure is handled explicitly.
check() {
  local repo=$1 name=$2 b=$3 wt=$4 json cls glyph state_file prev line errf
  errf=$(mktemp)
  if ! json=$(cd "$repo" && with_timeout "$TIMEOUT" sd-state --json "$b" 2>"$errf" </dev/null); then
    write_glyph "$wt" "$b" ⚠️
    printf '%s\t%s\t⚠️\tsd state failed: %s\n' "$name" "$b" "$(head -1 "$errf")"
    rm -f "$errf"
    return
  fi
  rm -f "$errf"
  if ! cls=$(prc_json "$CLASSIFY" "$json" 2>/dev/null) || [[ -z $cls ]]; then
    write_glyph "$wt" "$b" ⚠️
    printf '%s\t%s\t⚠️\tunparseable sd state output\n' "$name" "$b"
    return
  fi
  glyph=$(prc_line 'values glyph' "$cls")

  state_file="$STATE_DIR/branches/$(basename "$repo")-$(printf '%s' "$repo" | shasum | cut -c1-8)/$b.json"
  mkdir -p "$(dirname "$state_file")"
  # An unreadable previous state re-notifies rather than silently dropping reasons.
  prev=$(prc_json 'values coalesce([unnest reasons | values key], [])' "$(cat "$state_file" 2>/dev/null)" 2>/dev/null) || prev='[]'
  [[ -n $prev ]] || prev='[]'
  while IFS= read -r line; do
    [[ -n $line ]] && notify "$name $b" "$line"
  done < <(prc_line 'unnest {prev, r: c.reasons} | where not (r.key in prev) | values r.msg' "{\"prev\": $prev, \"c\": $cls}")
  prc_json 'values {...c, state: s}' "{\"c\": $cls, \"s\": $json}" > "$state_file.tmp" \
    && mv "$state_file.tmp" "$state_file"

  write_glyph "$wt" "$b" "$glyph"
  printf '%s\t%s\t%s\t%s\n' "$name" "$b" "$glyph" \
    "$(prc_line 'values sj(coalesce([unnest [...reasons, {msg: coalesce(note, null)}] | where msg is not null | values msg], []), "; ")' "$cls")"
}

# sweep_pins <repo>: delete refs/sheepdog/<b>/* whose branch no longer exists.
# Refs outlive `git branch -D` (config doesn't); the pin's last path component
# is its kind (base, local, bot, accepted), the rest is the branch name.
sweep_pins() {
  local ref b
  while read -r ref; do
    b=${ref#refs/sheepdog/}; b=${b%/*}
    git -C "$1" rev-parse -q --verify "refs/heads/$b" >/dev/null 2>&1 || echo "delete $ref"
  done < <(git -C "$1" for-each-ref --format='%(refname)' refs/sheepdog/) \
    | git -C "$1" update-ref --stdin
}

run_pass() {
  mkdir -p "$STATE_DIR" "$STATUS_DIR"
  WRITTEN=$(mktemp)
  trap 'rm -f "$WRITTEN"' EXIT
  local -a repos branches
  local repo name remote b lines="" key val wt_path fetch_err
  mapfile -t repos < <(git config --global --get-all sheepdog.repo || true)

  for repo in "${repos[@]}"; do
    [[ -d $repo ]] || continue
    name=$(basename "$repo")
    mapfile -t branches < <(git -C "$repo" config --get-regexp '^branch\..*\.sheepdog$' 2>/dev/null \
      | awk '$2 == "true" { sub(/^branch\./, "", $1); sub(/\.sheepdog$/, "", $1); print $1 }')
    sweep_pins "$repo"
    (( ${#branches[@]} )) || continue

    if ! remote=$(cd "$repo" && prc_get settings.remote "" true); then
      lines+="$name"$'\t-\t⚠️\t'"sd config failed"$'\n'
      continue
    fi
    if ! fetch_err=$(with_timeout "$TIMEOUT" git -C "$repo" fetch --prune --quiet "$remote" 2>&1 </dev/null); then
      lines+="$name"$'\t-\t⚠️\t'"fetch from $remote failed: ${fetch_err%%$'\n'*}"$'\n'
    fi

    local -A worktree_of=()
    while read -r key val; do
      case $key in
        worktree) wt_path=$val ;;
        branch) worktree_of[${val#refs/heads/}]=$wt_path ;;
      esac
    done < <(git -C "$repo" worktree list --porcelain)

    for b in "${branches[@]}"; do
      lines+=$(check "$repo" "$name" "$b" "${worktree_of[$b]:-}")$'\n'
    done
    unset worktree_of
  done

  local f
  for f in "$STATUS_DIR"/*.pr; do
    [[ -e $f ]] || continue
    grep -qxF "$f" "$WRITTEN" || rm -f "$f"
  done
  { date '+last pass: %Y-%m-%d %H:%M:%S'; printf '%s' "$lines"; } > "$STATE_DIR/last-pass"
}

plist_path() { echo "$LAUNCH_AGENTS/$LABEL.plist"; }

xml() { local v=${1//&/\&amp;}; v=${v//</\&lt;}; printf '%s' "${v//>/\&gt;}"; }

install_job() {
  local plist prog interval tmp
  plist=$(plist_path)
  prog="$HOME/.local/bin/sd"
  [[ -x $prog ]] || prog=$(realpath "$(dirname "$(realpath "$0")")/../bin/sd")
  interval=$(prc_get settings.interval "" true) || { echo "sd watch: sd config failed" >&2; exit 1; }
  [[ $interval =~ ^[1-9][0-9]*$ ]] || { echo "sd watch: settings.interval must be whole seconds: $interval" >&2; exit 1; }
  mkdir -p "$LAUNCH_AGENTS" "$STATE_DIR"
  tmp=$(mktemp)
  cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$(xml "$prog")</string><string>watch</string></array>
  <key>StartInterval</key><integer>$interval</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$(xml "$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")</string>
  </dict>
  <key>StandardOutPath</key><string>$(xml "$STATE_DIR/launchd.log")</string>
  <key>StandardErrorPath</key><string>$(xml "$STATE_DIR/launchd.log")</string>
</dict>
</plist>
EOF
  plutil -lint -s "$tmp" || { rm -f "$tmp"; echo "sd watch: generated plist is invalid" >&2; exit 1; }
  mv "$tmp" "$plist"
  retire_old_labels
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "installed $plist (every ${interval}s)"
}

retire_old_labels() {
  local l
  for l in "${OLD_LABELS[@]}"; do
    launchctl bootout "gui/$(id -u)/$l" 2>/dev/null || true
    rm -f "$LAUNCH_AGENTS/$l.plist"
  done
}

uninstall_job() {
  retire_old_labels
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  rm -f "$(plist_path)"
  echo "uninstalled $LABEL"
}

case ${1:-} in
  "") prc_super_init || exit 1; run_pass ;;
  status)
    if [[ -f $STATE_DIR/last-pass ]]; then sed "s/$(printf '\t')/  /g" "$STATE_DIR/last-pass"; else echo "no pass yet"; fi ;;
  install) prc_super_init || exit 1; install_job ;;
  uninstall) uninstall_job ;;
  -h|--help) sed -n '3,/^$/s/^# \{0,1\}//p' "$0" ;;
  *) echo "sd watch: unknown command: $1" >&2; exit 1 ;;
esac

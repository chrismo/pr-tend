#!/usr/bin/env bash5
#
# super-stress - run each converted SuperDB filter many times on fixture
# input; a panic or an output that differs between runs fails it.
#
# Usage: ci/super-stress [-n <runs>] [<name>=<query-file>:<fixture>[:<mode>]]...
#
# super 0.3.0 panicked intermittently on one construct (`unnest … into`,
# "context canceled", 12 of 200 runs), and these filters run unattended on
# every watcher pass. So every run of a filter (default 200) must exit 0 with
# the output of the first.
#
# With no arguments, the built-in list: every `read -r -d '' NAME <<'EOF'`
# query in bin/pr-state, bin/pr-act and bin/pr-watch, and lib/pr-next.sh's
# PRN_QUERY, each over its ci/fixtures/*.json input; the field picks
# (prc_val) and one-line queries use nothing these don't. Mode json (default)
# runs the query through prc_json, line through prc_line. One line per
# filter, then "super-stress: <filters> filters, <runs> runs each, <failures>
# failures"; exit 1 on any failure.

set -uo pipefail

ROOT=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
source "$ROOT/lib/pr-config.sh"
source "$ROOT/lib/pr-next.sh"
FIX=$ROOT/ci/fixtures

die() { echo "super-stress: $*" >&2; exit 1; }

runs=200
while (( $# )); do
  case $1 in
    -n) (( $# > 1 )) || die "-n needs a value"; runs=$2; shift ;;
    -h|--help) sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) break ;;
  esac
  shift
done
[[ $runs =~ ^[1-9][0-9]*$ ]] || die "-n must be a whole number: $runs"
prc_super_init || exit 1

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# heredoc <file> <NAME>: the query between `read -r -d '' NAME <<'EOF'` and EOF.
heredoc() {
  local out=$WORK/${1##*/}.$2.spq
  sed -n "/^read -r -d '' $2 <<'EOF'/,/^EOF\$/p" "$1" | sed '1d;$d' > "$out"
  [[ -s $out ]] || die "no heredoc $2 in $1"
  echo "$out"
}

entries=()
add() { entries+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"${4:-json}"); } # <name> <query-file> <fixture> [json|line]

builtin_list() {
  local st=$ROOT/bin/pr-state act=$ROOT/bin/pr-act
  add pr-state:PICK_PR "$(heredoc "$st" PICK_PR)" "$FIX/gh-pr.json"
  add pr-state:ASSEMBLE "$(heredoc "$st" ASSEMBLE)" "$FIX/state-args.json"
  add pr-state:LINE "$(heredoc "$st" LINE)" "$FIX/state.json" line
  add pr-state:LONG "$(heredoc "$st" LONG)" "$FIX/state.json" line
  add pr-watch:CLASSIFY "$(heredoc "$ROOT/bin/pr-watch" CLASSIFY)" "$FIX/state.json"
  add pr-act:GATE "$(heredoc "$act" GATE)" "$FIX/state.json"
  add pr-act:TRIGGER_GATE "$(heredoc "$act" TRIGGER_GATE)" "$FIX/state.json"
  add pr-act:RETARGET_GATE "$(heredoc "$act" RETARGET_GATE)" "$FIX/state.json"
  add pr-act:RESTACK_GATE "$(heredoc "$act" RESTACK_GATE)" "$FIX/restack.json"
  add pr-act:ACK_Q "$(heredoc "$act" ACK_Q)" "$FIX/ack.json" line
  add pr-act:FINDINGS_Q "$(heredoc "$act" FINDINGS_Q)" "$FIX/findings.json"
  add pr-act:PLAN_Q "$(heredoc "$act" PLAN_Q)" "$FIX/plan.json"
  printf '%s\n' "$PRN_QUERY" > "$WORK/pr-next.PRN_QUERY.spq"
  add pr-next:PRN_QUERY "$WORK/pr-next.PRN_QUERY.spq" "$FIX/next.json"
}

if (( $# )); then
  for a; do
    [[ $a =~ ^([^=]+)=([^:]+):([^:]+)(:(json|line))?$ ]] || die "expected <name>=<query-file>:<fixture>[:json|line]: $a"
    add "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[5]:-json}"
  done
else
  builtin_list
fi

# stress <name> <query-file> <fixture> <mode> <out>: <runs> runs; the report
# in <out>, the failure count in <out>.fails.
stress() {
  local name=$1 fixture=$3 mode=$4 out=$5 q i rc got first="" have_first=false fails=0 why=""
  exec > "$out"
  q=$(cat "$2") || { echo "$name: can't read $2"; echo 1 > "$out.fails"; return; }
  [[ -r $fixture ]] || { echo "$name: can't read $fixture"; echo 1 > "$out.fails"; return; }
  for ((i = 1; i <= runs; i++)); do
    if [[ $mode == line ]]; then got=$(cat "$fixture" | prc_line "$q" 2>&1); rc=$?
    else got=$(cat "$fixture" | prc_json "$q" 2>&1); rc=$?
    fi
    if (( rc != 0 )); then
      (( fails++ )); why+="  run $i: exit $rc: ${got%%$'\n'*}"$'\n'
    elif ! $have_first; then
      first=$got have_first=true
    elif [[ $got != "$first" ]]; then
      (( fails++ )); why+="  run $i: output differs from run 1"$'\n'
    fi
  done
  echo "$name: $runs runs, $fails failures"
  [[ -z $why ]] || printf '%s' "$why" | head -5
  echo "$fails" > "$out.fails"
}

i=0
for e in "${entries[@]}"; do
  IFS=$'\t' read -r name qf fixture mode <<<"$e"
  (stress "$name" "$qf" "$fixture" "$mode" "$WORK/$i.out") &
  i=$((i + 1))
done
wait

total=0
for ((j = 0; j < i; j++)); do
  cat "$WORK/$j.out"
  total=$((total + $(cat "$WORK/$j.out.fails")))
done
echo "super-stress: $i filters, $runs runs each, $total failures"
(( total == 0 ))
